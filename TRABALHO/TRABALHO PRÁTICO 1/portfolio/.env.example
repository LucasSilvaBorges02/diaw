# Copie este arquivo para .env.local e preencha com os dados da sua conta no EmailJS
# (https://dashboard.emailjs.com). Na Vercel, cadastre as mesmas variáveis em
# Settings > Environment Variables.
VITE_EMAILJS_SERVICE_ID=seu_service_id
VITE_EMAILJS_TEMPLATE_ID=seu_template_id
VITE_EMAILJS_PUBLIC_KEY=sua_public_key
